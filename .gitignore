# ============================================================
# my-mind-map 忽略规则
# 仅覆盖仓库中实际出现的依赖、构建产物、运行期数据与本地文件
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
# 根目录 dist：web（vue-cli）构建输出，web/vue.config.js 中 outputDir 为 ../dist
/dist/
# 根目录 index.html：web 构建脚本经 copy.js 从 dist/index.html 复制生成
/index.html
# myweb（Vite）构建输出
myweb/dist/
# simple-mind-map 库的构建输出与类型声明
simple-mind-map/dist/
simple-mind-map/types/
# 上游 Electron / uTools 打包产物（当前仓库未使用，沿用原有规则）
dist_electron/
utools/dist/

# ---------- 运行期数据与上传 ----------
# sql.js 数据库（启动时自动创建，含账号、团队、明文 AI API Key）
server/data/
# 头像与节点图片上传目录（运行时由 server/index.js 自动创建）
server/uploads/

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 临时文件与缓存 ----------
.cache/
.screenshots/
*.tmp
.eslintcache
coverage/
.nyc_output/

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ---------- 本地环境变量 ----------
# 注意：web/.env.library 是库构建模式必需文件（内容仅 NODE_ENV=library），需要保留
.env
.env.local
.env.*.local

# ---------- 离线部署包 ----------
# deploy/ 整体视为打包产物：压缩包、SHA256、运行期下载的 node/nginx 二进制、
# 打包进包内的 web 构建产物、server 源码副本与 node_modules、运行期 data/uploads/logs 均不提交。
# 但包内手写的部署文档、启动/停止脚本、nginx 模板与 server.env 示例属于可维护内容，单独放行。
# 用 /deploy/* 而不是 /deploy/：目录本身不被排除，内部文件才能按需放行
/deploy/*
!/deploy/mindmap-offline/
/deploy/mindmap-offline/*
!/deploy/mindmap-offline/README.txt
!/deploy/mindmap-offline/docs/
!/deploy/mindmap-offline/scripts/
!/deploy/mindmap-offline/nginx/
!/deploy/mindmap-offline/config/
/deploy/mindmap-offline/config/*
# server.env 可能被填入真实 JWT_SECRET / AI_API_KEY，只提交示例文件
!/deploy/mindmap-offline/config/server.env.example
